# Mythic Spellbook MP server — env template.
# Copy to .env (which is gitignored) and fill in real values for local dev.
# In production these are set via `fly secrets set`.

# Supabase project URL — used to fetch the JWKS for JWT verification.
SUPABASE_URL=https://ktsiasyjusesawtrwrjc.supabase.co

# JWT audience — Supabase's default is 'authenticated'.
SUPABASE_JWT_AUDIENCE=authenticated

# Allowed origins (CORS). Comma-separated. Use * only in dev.
CORS_ORIGINS=*

# Port the server listens on. Default 2567 (Colyseus convention).
PORT=2567

# Local dev only — skip JWT verification entirely. NEVER set true in production.
AUTH_DEV_BYPASS=false

# Optional: Colyseus monitor dashboard credentials. Leave blank to disable.
# When set, basic-auth-gates the /colyseus path so you can inspect live rooms.
MONITOR_USER=
MONITOR_PASS=
