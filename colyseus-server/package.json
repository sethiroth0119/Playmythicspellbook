{
  "name": "mythic-spellbook-mp-server",
  "version": "0.1.0",
  "description": "Authoritative multiplayer server for Mythic Spellbook — Colyseus rooms over WebSocket.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "parity": "node test/catalog-parity.mjs",
    "test": "tsc && node test/catalog-parity.mjs && node test/damage-golden.mjs",
    "loadtest": "colyseus-loadtest loadtest/example.ts --room battle --numClients 10"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/monitor": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/tools": "^0.16.0",
    "@colyseus/ws-transport": "^0.16.0",
    "colyseus": "^0.16.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "colyseus.js": "^0.16.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
