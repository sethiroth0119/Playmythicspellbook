// 🧪 TEST WORKER — separate Cloudflare worker for visual experiments.
// Shares the same Supabase backend so the user can sign in as themselves
// and use their real decks/heroes; the only thing different from prod is
// the bundled HTML/CSS/Pixi code being tested.
//
// Deploy with:  npm run deploy:test
// URL pattern:  https://playmythicspellbook-test.<your-workers-subdomain>.workers.dev
//
// To promote the test build to live, run the normal `npm run deploy` after
// you're satisfied — that publishes the same source to the live worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playmythicspellbook-test",
  "compatibility_date": "2024-09-25",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "SB_URL": "https://ktsiasyjusesawtrwrjc.supabase.co",
    "SB_ANON": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0c2lhc3lqdXNlc2F3dHJ3cmpjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg2NDU5MjgsImV4cCI6MjA5NDIyMTkyOH0.fYpQFCs03ZE5AIv88S_GStqp7g71sTQe9yUxmXgyKQo"
  }
}
